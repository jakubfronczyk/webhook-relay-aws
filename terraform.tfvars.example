# Copy this file to terraform.tfvars and fill in your actual values.
# terraform.tfvars is gitignored and will not be committed.

# AWS configuration
aws_region = "us-east-1"

# Credentials come from AWS_PROFILE, never from this file.

# Project configuration
environment  = "dev"
project_name = "webhook-relay"

# Cost guardrail. Required, the budget notifies nobody without it.
monthly_budget_usd = 20
alert_emails       = ["you@example.com"]

# Network layout
vpc_cidr                      = "10.0.0.0/16"
public_subnet_cidr            = "10.0.1.0/24"
public_subnet_secondary_cidr  = "10.0.2.0/24"
private_subnet_cidr           = "10.0.11.0/24"
private_subnet_secondary_cidr = "10.0.12.0/24"
